# ---------------------------------------------------------------------------
# Copy this file to `.env` and edit. Never commit the real .env.
# ---------------------------------------------------------------------------

# Signs the session cookie. Change it; anything random and long is fine.
SECRET_KEY=change-me-to-a-long-random-string

# --- Database -------------------------------------------------------------
# MySQL (the schema you already have in database/legal_dms_database.sql):
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/legal_dms

# Zero-setup fallback for demos — no MySQL install needed. Uncomment to use:
# DATABASE_URL=sqlite:///veridex.db

# --- Frontend origins allowed to call this API (CORS) ---------------------
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

# Where the API sends officers after a successful sign-in.
#   3 dev servers  -> http://localhost:5173  (the Vite console)
#   single-port build -> /console
CONSOLE_URL=http://localhost:5173

# Password given to every seeded demo officer by `flask seed`.
DEMO_PASSWORD=Veridex@2026

# Session lifetime in minutes (the login page promises 15 at the counter).
SESSION_MINUTES=480
