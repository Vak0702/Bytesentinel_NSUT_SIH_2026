# Copy to `.env.local`. Values prefixed NEXT_PUBLIC_ are readable in the browser.

# Flask API — used server-side by the /api/* rewrite in next.config.mjs.
API_ORIGIN=http://localhost:5000

# Where a signed-in officer is sent. Dev = the Vite console on 5173.
# After a production build, set this to /console.
NEXT_PUBLIC_CONSOLE_URL=http://localhost:5173
